                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Calificacion">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(
    IsNumeric(Fields!Calificacion.Value) AND 
    IsNumeric(Fields!TotalRecepciones.Value) AND 
    CDbl(Fields!TotalRecepciones.Value) &gt; 0,
    FormatNumber(CDbl(Fields!Calificacion.Value) / CDbl(Fields!TotalRecepciones.Value), 0),
    "0"
)</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
